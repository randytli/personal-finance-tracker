# Copy to .env.backend.production.local and keep that file private.
# Never commit or print the values entered there.

PLAID_ENV=production
PLAID_CLIENT_ID=
PLAID_SECRET=

# Generate this yourself. Losing it makes stored Production access tokens unusable.
PLAID_TOKEN_ENCRYPTION_KEY=
PLAID_PILOT_USER_ID=
PLAID_REDIRECT_URI=https://your-temporary-tunnel.example/plaid-oauth

# Keep false until the HTTPS callback is registered and you are ready to connect.
PLAID_PILOT_LINK_ENABLED=false

PFT_PILOT_DB_USER=
PFT_PILOT_DB_PASSWORD=
PFT_PILOT_DB_NAME=pft_production_pilot
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5433/pft_production_pilot
EXPECTED_DATABASE_NAME=pft_production_pilot
