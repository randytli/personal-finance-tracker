-- PREPARATION ONLY. Never execute against an existing/local/Production database.
-- First verify the newly created Free project's control-plane ref and name.
-- Render these five placeholders using fresh synthetic IDs and role passwords;
-- keep rendered SQL private, outside the repository and deployment trees.
-- Use provider SQL tooling against that NEW project only. No financial tables.
BEGIN;
DO $$ BEGIN
  IF EXISTS (SELECT 1 FROM pg_namespace WHERE nspname = 'pft_m5_probe')
     OR EXISTS (SELECT 1 FROM pg_roles WHERE rolname IN ('pft_m5_reader','pft_m5_jobs')) THEN
    RAISE EXCEPTION 'Fresh synthetic project required; existing objects rejected';
  END IF;
END $$;
CREATE ROLE pft_m5_reader LOGIN PASSWORD '<FRESH_READER_DB_PASSWORD>'
  NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS CONNECTION LIMIT 8;
CREATE ROLE pft_m5_jobs LOGIN PASSWORD '<FRESH_JOBS_DB_PASSWORD>'
  NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS CONNECTION LIMIT 12;
ALTER ROLE pft_m5_reader SET default_transaction_read_only = on;
CREATE SCHEMA pft_m5_probe;
REVOKE ALL ON SCHEMA pft_m5_probe FROM PUBLIC;
CREATE TABLE pft_m5_probe.identity (
  singleton boolean PRIMARY KEY CHECK (singleton),
  dataset_id text NOT NULL CHECK (dataset_id ~ '^m5-[a-f0-9]{32}$'),
  deployment_id text NOT NULL CHECK (deployment_id ~ '^m5-[a-f0-9]{32}$'),
  project_ref text NOT NULL CHECK (project_ref ~ '^[a-z]{20}$')
);
INSERT INTO pft_m5_probe.identity VALUES
  (true, '<NEW_DATASET_ID>', '<NEW_EXPERIMENT_ID>', '<NEW_PROJECT_REF>');
REVOKE ALL ON pft_m5_probe.identity FROM PUBLIC;
GRANT USAGE ON SCHEMA pft_m5_probe TO pft_m5_reader, pft_m5_jobs;
GRANT SELECT ON pft_m5_probe.identity TO pft_m5_reader, pft_m5_jobs;
COMMIT;
