# Copy to .env.runtime.local. Never commit the filled file.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_PILOT_USER_ID=local-sandbox-user
PLAID_PILOT_LINK_ENABLED=false
DATABASE_URL=postgresql+asyncpg://pft:replace-with-a-long-random-value@db:5432/pft_runtime_isolated
EXPECTED_DATABASE_NAME=pft_runtime_isolated
PFT_STRICT_LOCAL_HTTP=true
PFT_ALLOWED_ORIGIN=http://127.0.0.1:3000
